 post /v1/admin/draw-versions (SaveDrawVersionRequest) returns (SaveDrawVersionResponse)
 @handler setDrawControl
 post /v1/admin/draw-control (SetDrawControlRequest) returns (ManagedDrawResponse)
}

type (
    ChainAsset {
        Id string `json:"id"`
        Symbol string `json:"symbol"`
        Contract string `json:"contract"`
        Decimals int `json:"decimals"`
        Origin string `json:"origin,options=native|issuer|test_fixture"`
        DepositPreview bool `json:"depositPreview,optional"`
    }
    ChainNetwork {
        Id string `json:"id"`
        Family string `json:"family,options=ton|base|solana|tron"`
        Testnet bool `json:"testnet"`
        Enabled bool `json:"enabled"`
        Assets []ChainAsset `json:"assets"`
    }
    ChainAssetCatalogData {
        Networks []ChainNetwork `json:"networks"`
    }
    ChainAssetCatalogResponse {
        Code string `json:"code,options=OK"`
        Message string `json:"message"`
        TraceId string `json:"traceId"`
        Data ChainAssetCatalogData `json:"data"`
    }
    ChainBalancesRequest {
        Network string `json:"network"`
        Address string `json:"address"`
    }
    ChainAssetBalance {
        AssetId string `json:"assetId"`
        Quantity string `json:"quantity"`
        Status string `json:"status,options=ok|unavailable"`
        ErrorCode string `json:"errorCode,options=NONE|UPSTREAM_UNAVAILABLE|UPSTREAM_INVALID|NETWORK_MISMATCH"`
        QueriedAt int64 `json:"queriedAt"`
    }
    ChainBalancesData {
        Network string `json:"network"`
        Address string `json:"address"`
        Items []ChainAssetBalance `json:"items"`
    }
    ChainBalancesResponse {
        Code string `json:"code,options=OK"`
        Message string `json:"message"`
        TraceId string `json:"traceId"`
        Data ChainBalancesData `json:"data"`
    }
)
@server(group: chainassets middleware: AuthTransport,UserAuth)
service platform {
    @handler chainAssetCatalog
    get /v1/user/chain-assets returns (ChainAssetCatalogResponse)
    @handler chainBalances
    post /v1/user/chain-assets/balances (ChainBalancesRequest) returns (ChainBalancesResponse)
}

// Read-only chain destination preparation. These are not payment orders.
type ChainTargetRequest {
    Network string `json:"network,optional"`
    AssetId string `json:"assetId,optional"`
    Address string `json:"address,optional"`
    ReceiveCode string `json:"receiveCode,optional"`
}
type ChainTargetData {
    Network string `json:"network"`
    AssetId string `json:"assetId"`
    Address string `json:"address"`
    ReceiveCode string `json:"receiveCode"`
}
type ChainTargetResponse {
    Code string `json:"code,options=OK"`
    Message string `json:"message"`
    TraceId string `json:"traceId"`
    Data ChainTargetData `json:"data"`
}
type ChainTransferPreviewRequest {
    Network string `json:"network"`
    AssetId string `json:"assetId"`
    Address string `json:"address"`
    Amount string `json:"amount"`
}
type ChainTransferPreviewData {
    Target ChainTargetData `json:"target"`
    Amount string `json:"amount"`
    CanSubmit bool `json:"canSubmit"`
    BlockReason string `json:"blockReason,options=CHANNEL_NOT_OPEN"`
}
type ChainTransferPreviewResponse {
    Code string `json:"code,options=OK"`
    Message string `json:"message"`
    TraceId string `json:"traceId"`
    Data ChainTransferPreviewData `json:"data"`
}
@server (
    group: chainassets
    middleware: AuthTransport,UserAuth
)
service platform {
    @handler chainTarget
    post /v1/user/chain-transfer-targets/resolve (ChainTargetRequest) returns (ChainTargetResponse)
    @handler chainTransferPreview
    post /v1/user/chain-transfers/preview (ChainTransferPreviewRequest) returns (ChainTransferPreviewResponse)
}

// Indicative testnet estimate for the authenticated user's own USD balance.
type DepositQuoteRequest {
    AssetId string `json:"assetId"`
    TargetUsd string `json:"targetUsd"`
    WalletAddress string `json:"walletAddress,optional"`
}
type DepositQuoteData {
    BaseRecipient string `json:"baseRecipient,optional,omitempty"`
    BaseFeePayer string `json:"baseFeePayer,optional,omitempty"`
    BaseValidBefore int64 `json:"baseValidBefore,optional,omitempty"`
    SolOrderIdx string `json:"solOrderIdx,optional,omitempty"`
    SolRecipient string `json:"solRecipient,optional,omitempty"`
    SolFeePayer string `json:"solFeePayer,optional,omitempty"`
    QuoteIdx string `json:"quoteIdx,optional,omitempty"`
    MaxGas string `json:"maxGas,optional,omitempty"`
    AssetId string `json:"assetId"`
    TargetUsd string `json:"targetUsd"`
    UsdPerCoin string `json:"usdPerCoin"`
    PayQuantity string `json:"payQuantity"`
    GasAssetId string `json:"gasAssetId"`
    EstimatedGas string `json:"estimatedGas"`
    GasUsd string `json:"gasUsd"`
    NetUsd string `json:"netUsd"`
    RateVersion string `json:"rateVersion"`
    RateSource string `json:"rateSource,optional,options=test_sheet|kraken"`
    AsOf int64 `json:"asOf"`
    QuotedAt int64 `json:"quotedAt"`
    ExpiresAt int64 `json:"expiresAt"`
    WalletFeePreview bool `json:"walletFeePreview,optional"`
    WalletAddress string `json:"walletAddress,optional"`
    MessageSha256 string `json:"messageSha256,optional"`
    FeeBlockHash string `json:"feeBlockHash,optional"`
    EmulatedMessageHash string `json:"emulatedMessageHash,optional,omitempty"`
    RelayAttached string `json:"relayAttached,optional,omitempty"`
    JettonExcess string `json:"jettonExcess,optional,omitempty"`
    RelaySurplus string `json:"relaySurplus,optional,omitempty"`
    DelegatedEnergy int64 `json:"delegatedEnergy,optional,omitempty"`
    DelegatedBandwidth int `json:"delegatedBandwidth,optional,omitempty"`
    AccountFunding string `json:"accountFunding,optional"`
    AccountFundingUsd string `json:"accountFundingUsd,optional"`
    CanSubmit bool `json:"canSubmit"`
}
type DepositQuoteResponse {
    Code string `json:"code,options=OK"`
    Message string `json:"message"`
    TraceId string `json:"traceId"`
    Data DepositQuoteData `json:"data"`
}
type DepositQuoteConfirmRequest {
    QuoteIdx string `json:"quoteIdx"`
}
type DepositQuoteLookupRequest {
    QuoteIdx string `path:"quoteIdx"`
}
type ConfirmedDepositQuoteData {
    Quote DepositQuoteData `json:"quote"`
    ConfirmedAt int64 `json:"confirmedAt"`
}
type ConfirmedDepositQuoteResponse {
    Code string `json:"code,options=OK"`
    Message string `json:"message"`
    TraceId string `json:"traceId"`
    Data ConfirmedDepositQuoteData `json:"data"`
}
@server (
    group: chainassets
    timeout: 30s
    middleware: AuthTransport,UserAuth
)
service platform {
    @handler depositQuotePreview
    post /v1/user/deposit-quotes/preview (DepositQuoteRequest) returns (DepositQuoteResponse)
    @handler depositQuoteConfirm
    post /v1/user/deposit-quotes/confirm (DepositQuoteConfirmRequest) returns (ConfirmedDepositQuoteResponse)
    @handler confirmedDepositQuote
    get /v1/user/deposit-quotes/:quoteIdx (DepositQuoteLookupRequest) returns (ConfirmedDepositQuoteResponse)
}

type BaseDepositAuthorizeRequest {
    QuoteIdx string `json:"quoteIdx"`
    UserSignature string `json:"userSignature"`
}
type BaseDepositOrderData {
    QuoteIdx string `json:"quoteIdx"`
    State string `json:"state,options=awaiting_signature|expired|accepted|signed|review|credited"`
    TxHash string `json:"txHash,optional,omitempty"`
    ActualFeeWei string `json:"actualFeeWei,optional,omitempty"`
    CreditedUsd string `json:"creditedUsd,optional,omitempty"`
}
type BaseDepositOrderResponse {
    Code string `json:"code,options=OK"`
    Message string `json:"message"`
    TraceId string `json:"traceId"`
    Data BaseDepositOrderData `json:"data"`
}
type SolDepositAuthorizeRequest {
    QuoteIdx string `json:"quoteIdx"`
    UserSignature string `json:"userSignature"`
}
type SolDepositOrderData {
    QuoteIdx string `json:"quoteIdx"`
    OrderIdx string `json:"orderIdx"`
    State string `json:"state,options=awaiting_signature|accepted"`
    ExecutionState string `json:"executionState,options=waiting|signed|submitted|review|finalized|failed"`
    TxSignature string `json:"txSignature,optional,omitempty"`
    AssetId string `json:"assetId"`
    ActualFundingLamports string `json:"actualFundingLamports,optional,omitempty"`
    ActualFeeLamports int64 `json:"actualFeeLamports,optional,omitempty"`
    CreditedUsd string `json:"creditedUsd,optional,omitempty"`
    CreditedAt int64 `json:"creditedAt,optional,omitempty"`
    MessageBase64 string `json:"messageBase64"`
    MessageSha256 string `json:"messageSha256"`
    LastValidBlockHeight int64 `json:"lastValidBlockHeight"`
    QuoteExpiresAt int64 `json:"quoteExpiresAt"`
    ReviewAfter int64 `json:"reviewAfter"`
    AcceptedAt int64 `json:"acceptedAt,optional,omitempty"`
}
type SolDepositOrderResponse {
    Code string `json:"code,options=OK"`
    Message string `json:"message"`
    TraceId string `json:"traceId"`
    Data SolDepositOrderData `json:"data"`
}
@server (
    group: chainassets
    timeout: 30s
    middleware: AuthTransport,UserAuth
)
service platform {
    @handler authorizeBaseDeposit
    post /v1/user/base-deposit-orders/authorize (BaseDepositAuthorizeRequest) returns (BaseDepositOrderResponse)
    @handler getBaseDeposit
    get /v1/user/base-deposit-orders/:quoteIdx (DepositQuoteLookupRequest) returns (BaseDepositOrderResponse)
    @handler prepareSolDeposit
    post /v1/user/sol-deposit-orders/prepare (DepositQuoteConfirmRequest) returns (SolDepositOrderResponse)
    @handler authorizeSolDeposit
    post /v1/user/sol-deposit-orders/authorize (SolDepositAuthorizeRequest) returns (SolDepositOrderResponse)
    @handler getSolDeposit
    get /v1/user/sol-deposit-orders/:quoteIdx (DepositQuoteLookupRequest) returns (SolDepositOrderResponse)
}
