syntax = "v1"

type (
    ErrorResponse {
        Code string `json:"code,options=INVALID_ARGUMENT|UNAUTHENTICATED|PERMISSION_DENIED|NOT_FOUND|METHOD_NOT_ALLOWED|CONFLICT|UNPROCESSABLE|RATE_LIMITED|INTERNAL_ERROR|SERVICE_UNAVAILABLE|REQUEST_TIMEOUT|PAYLOAD_TOO_LARGE|AUTH_PROOF_INVALID|IDENTITY_OCCUPIED|ANOTHER_IDENTITY_REQUIRED|IDENTITY_ALREADY_BOUND|PAYMENT_RESTRICTED|TRANSFER_AMOUNT_LIMIT|TRANSFER_DAILY_LIMIT|INSUFFICIENT_BALANCE|TRANSFER_REQUEST_CONFLICT|TRANSFER_OUTCOME_UNKNOWN|TRANSFER_BUSY|TRANSFER_RECIPIENT_UNAVAILABLE|IDENTITY_HISTORY_UNKNOWN"`
        Message string `json:"message"`
        TraceId string `json:"traceId"`
    }
    HealthData {
        Status string `json:"status,options=live|ready"`
    }
    HealthResponse {
        Code string `json:"code,options=OK"`
        Message string `json:"message"`
        Data HealthData `json:"data"`
        TraceId string `json:"traceId"`
    }
)

@server(group: health)
service platform {
    @handler live
    get /health/live returns (HealthResponse)
    @handler ready
    get /health/ready returns (HealthResponse)
}

type (
    SendEmailRequest {
        Email string `json:"email"`
        Locale string `json:"locale,default=en,options=en|zh-CN"`
    }
    EmailLoginRequest {
        Email string `json:"email"`
        Challenge string `json:"challenge"`
        Code string `json:"code"`
    }
    TelegramLoginRequest {
        InitData string `json:"initData"`
    }
    IdentityEmailCodeRequest {
        SendEmailRequest
        Purpose string `json:"purpose,options=bind|replace"`
    }
    IdentityEmailRequest {
        IdentityApproval
        EmailLoginRequest
        Purpose string `json:"purpose,options=bind|replace"`
    }
    IdentityTelegramRequest {
        IdentityApproval
        TelegramLoginRequest
        Purpose string `json:"purpose,options=bind|replace"`
    }
    UnbindRequest {
        Identity string `json:"identity,options=email|telegram"`
    }
    ChallengeData {
        Challenge string `json:"challenge"`
        ExpiresAt int64 `json:"expiresAt"`
    }
    ChallengeResponse {
        Code string `json:"code,options=OK"`
        Message string `json:"message"`
        Data ChallengeData `json:"data"`
        TraceId string `json:"traceId"`
    }
    TokenData {
        RestrictedUntil string `json:"restrictedUntil,optional"`
        AccessToken string `json:"accessToken"`
        UserIdx string `json:"userIdx"`
        ExpiresAt int64 `json:"expiresAt"`
    }
    TokenResponse {
        Code string `json:"code,options=OK"`
        Message string `json:"message"`
        Data TokenData `json:"data"`
        TraceId string `json:"traceId"`
    }
    CurrentUserData {
        Idx string `json:"idx"`
        Nickname string `json:"nickname"`
        AvatarUrl string `json:"avatarUrl"`
    }
    CurrentUserResponse {
        Code string `json:"code,options=OK"`
        Message string `json:"message"`
        Data CurrentUserData `json:"data"`
        TraceId string `json:"traceId"`
    }
    AccountBalance {
        Kind string `json:"kind"`
        Unit string `json:"unit"`
        Balance string `json:"balance"`
        HeldBalance string `json:"heldBalance"`
        TotalBalance string `json:"totalBalance"`
    }
    AccountBalancesData {
        Accounts []AccountBalance `json:"accounts"`
    }
    AccountEntriesRequest {
        Kind string `form:"kind,optional,options=usd_balance|reward_usd|task_points"`
        Before string `form:"before,optional"`
        Limit int `form:"limit,default=20,range=[1:100]"`
    }
    AccountEntry {
        Idx string `json:"idx"`
        VoucherIdx string `json:"voucherIdx"`
        BusinessType string `json:"businessType"`
        BusinessIdx string `json:"businessIdx"`
        Action string `json:"action"`
        Kind string `json:"kind"`
        Unit string `json:"unit"`
        Direction string `json:"direction,options=in|out"`
        Amount string `json:"amount"`
        BalanceAfter string `json:"balanceAfter"`
        BalancePart string `json:"balancePart,options=available|held"`
        Activity string `json:"activity,options=posted|held|consumed|released"`
        CreatedAt string `json:"createdAt"`
    }
    AccountHoldsRequest {
        Status string `form:"status,optional,options=held|consumed|released"`
        Before string `form:"before,optional"`
        Limit int `form:"limit,default=20,range=[1:100]"`
    }
    AccountHold {
        Idx string `json:"idx"`
        BusinessType string `json:"businessType"`
        BusinessIdx string `json:"businessIdx"`
        Amount string `json:"amount"`
        Unit string `json:"unit,options=USD"`
        Status string `json:"status,options=held|consumed|released"`
        Reason string `json:"reason"`
        HoldVoucherIdx string `json:"holdVoucherIdx"`
        ResolvedVoucherIdx string `json:"resolvedVoucherIdx"`
        CreatedAt string `json:"createdAt"`
        ResolvedAt string `json:"resolvedAt"`
    }
    AccountHoldsData {
        Holds []AccountHold `json:"holds"`
        NextCursor string `json:"nextCursor"`
    }
    AccountHoldsResponse {
        Code string `json:"code,options=OK"`
        Message string `json:"message"`
        Data AccountHoldsData `json:"data"`
        TraceId string `json:"traceId"`
    }
    AccountEntriesData {
        Entries []AccountEntry `json:"entries"`
        NextCursor string `json:"nextCursor"`
    }
    AccountEntriesResponse {
        Code string `json:"code,options=OK"`
        Message string `json:"message"`
        Data AccountEntriesData `json:"data"`
        TraceId string `json:"traceId"`
    }
    AccountBalancesResponse {
        Code string `json:"code,options=OK"`
        Message string `json:"message"`
        Data AccountBalancesData `json:"data"`
        TraceId string `json:"traceId"`
    }

)

@server(group: auth middleware: AuthTransport)
service platform {
    @handler sendEmail
    post /v1/user/auth/email/code (SendEmailRequest) returns (ChallengeResponse)
    @handler emailLogin
    post /v1/user/auth/email/login (EmailLoginRequest) returns (TokenResponse)
    @handler telegramLogin
    post /v1/user/auth/telegram/login (TelegramLoginRequest) returns (TokenResponse)
}

@server(group: account middleware: AuthTransport,UserAuth)
service platform {
    @handler currentUser
    get /v1/user/current returns (CurrentUserResponse)
    @handler accountHolds
    get /v1/user/account-holds (AccountHoldsRequest) returns (AccountHoldsResponse)
    @handler accountEntries
    get /v1/user/account-entries (AccountEntriesRequest) returns (AccountEntriesResponse)
    @handler accountBalances
    get /v1/user/accounts returns (AccountBalancesResponse)
    @handler identityEmailCode
    post /v1/user/identities/email/code (IdentityEmailCodeRequest) returns (ChallengeResponse)
}

@server(group: identity middleware: AuthTransport,UserAuth)
service platform {
    @handler identityEmail
    post /v1/user/identities/email/verify (IdentityEmailRequest) returns (TokenResponse)
    @handler identityTelegram
    post /v1/user/identities/telegram/verify (IdentityTelegramRequest) returns (TokenResponse)
    @handler unbind
    post /v1/user/identities/unbind (UnbindRequest) returns (TokenResponse)
}


type (
    IdentitySummary {
        Type string `json:"type,options=email|telegram"`
        Subject string `json:"subject"`
        DisplayName string `json:"displayName"`
    }
    IdentitiesData {
        Identities []IdentitySummary `json:"identities"`
    }
    IdentitiesResponse {
        Code string `json:"code,options=OK"`
        Message string `json:"message"`
        Data IdentitiesData `json:"data"`
        TraceId string `json:"traceId"`
    }
    UpdateProfileRequest {
        Nickname string `json:"nickname"`
    }
)

@server(group: account middleware: AuthTransport,UserAuth)
service platform {
    @handler currentIdentities
    get /v1/user/identities returns (IdentitiesResponse)
    @handler updateProfile
    patch /v1/user/profile (UpdateProfileRequest) returns (CurrentUserResponse)
}

// Backoffice accounts use independent tables, credentials and audiences.
type (
    BackofficeCodeRequest {
        SendEmailRequest
        Password string `json:"password"`
    }
    BackofficeLoginRequest {
        BackofficeCodeRequest
        Challenge string `json:"challenge"`
        Code string `json:"code"`
    }
    BackofficeAccount {
        Idx string `json:"idx"`
        Email string `json:"email"`
        Status string `json:"status,options=active|disabled"`
        MustChangePassword bool `json:"mustChangePassword"`
    }
    BackofficeAccountResponse {
        Code string `json:"code,options=OK"`
        Message string `json:"message"`
        TraceId string `json:"traceId"`
        Data BackofficeAccount `json:"data"`
    }
    BackofficeAccountsData {
        Items []BackofficeAccount `json:"items"`
    }
    BackofficeAccountsResponse {
        Code string `json:"code,options=OK"`
        Message string `json:"message"`
        TraceId string `json:"traceId"`
        Data BackofficeAccountsData `json:"data"`
    }
    BackofficeListRequest {
        Realm string `form:"realm,default=merchant,options=admin|merchant"`
        Page int64 `form:"page,default=1,range=[1:1000000]"`
    }
    BackofficeChangePasswordRequest {
        OldPassword string `json:"oldPassword"`
        Password string `json:"password"`
    }
    BackofficeCreateRequest {
        Email string `json:"email"`
        Password string `json:"password"`
        Reason string `json:"reason"`
    }
    BackofficeStatusRequest {
        Realm string `json:"realm,options=admin|merchant"`
        Idx string `json:"idx"`
        Status string `json:"status,options=active|disabled"`
        Reason string `json:"reason"`
    }
    BackofficeResetRequest {
        Realm string `json:"realm,options=admin|merchant"`
        Idx string `json:"idx"`
        Password string `json:"password"`
        Reason string `json:"reason"`
    }
    ManagedUserRequest {
        Idx string `form:"idx"`
    }
    ManagedUserStatusRequest {
        Idx string `json:"idx"`
        Status string `json:"status,options=active|disabled"`
        Reason string `json:"reason"`
    }
    ManagedUserData {
        Idx string `json:"idx"`
        Nickname string `json:"nickname"`
        Status string `json:"status,options=active|disabled"`
    }
    ManagedUserResponse {
        Code string `json:"code,options=OK"`
        Message string `json:"message"`
        TraceId string `json:"traceId"`
        Data ManagedUserData `json:"data"`
    }
    BackofficeAuditRequest {
        Page int64 `form:"page,default=1,range=[1:1000000]"`
    }
    BackofficeAuditItem {
        Id int64 `json:"id"`
        ActorRealm string `json:"actorRealm"`
        ActorIdx string `json:"actorIdx"`
        Action string `json:"action"`
        TargetRealm string `json:"targetRealm"`
        TargetIdx string `json:"targetIdx"`
        TargetEmail string `json:"targetEmail"`
        BeforeValue string `json:"beforeValue"`
        AfterValue string `json:"afterValue"`
        Reason string `json:"reason"`
        Result string `json:"result"`
        TraceId string `json:"traceId"`
        CreatedAt int64 `json:"createdAt"`
    }
    BackofficeAuditData {
        Items []BackofficeAuditItem `json:"items"`
    }
    BackofficeAuditResponse {
        Code string `json:"code,options=OK"`
        Message string `json:"message"`
        TraceId string `json:"traceId"`
        Data BackofficeAuditData `json:"data"`
    }
)

@server(group: backoffice middleware: BackofficeTransport)
service platform {
    @handler adminCode
    post /v1/admin/auth/code (BackofficeCodeRequest) returns (ChallengeResponse)
    @handler adminLogin
    post /v1/admin/auth/login (BackofficeLoginRequest) returns (TokenResponse)
}
@server(group: backoffice middleware: BackofficeTransport,AdminAuth)
service platform {
    @handler adminCurrent
    get /v1/admin/current returns (BackofficeAccountResponse)
    @handler adminPassword
    post /v1/admin/password (BackofficeChangePasswordRequest) returns (TokenResponse)
}

@server(group: backoffice middleware: BackofficeTransport)
service platform {
    @handler merchantCode
    post /v1/merchant/auth/code (BackofficeCodeRequest) returns (ChallengeResponse)
    @handler merchantLogin
    post /v1/merchant/auth/login (BackofficeLoginRequest) returns (TokenResponse)
}
@server(group: backoffice middleware: BackofficeTransport,MerchantAuth)
service platform {
    @handler merchantCurrent
    get /v1/merchant/current returns (BackofficeAccountResponse)
    @handler merchantPassword
    post /v1/merchant/password (BackofficeChangePasswordRequest) returns (TokenResponse)
}

@server(group: backoffice middleware: BackofficeTransport,AdminAuth)
service platform {
    @handler backofficeAccounts
    get /v1/admin/accounts (BackofficeListRequest) returns (BackofficeAccountsResponse)
    @handler createMerchant
    post /v1/admin/merchants (BackofficeCreateRequest) returns (BackofficeAccountResponse)
    @handler backofficeStatus
    post /v1/admin/accounts/status (BackofficeStatusRequest) returns (BackofficeAccountResponse)
    @handler backofficeReset
    post /v1/admin/accounts/reset (BackofficeResetRequest) returns (BackofficeAccountResponse)
    @handler managedUser
    get /v1/admin/user (ManagedUserRequest) returns (ManagedUserResponse)
    @handler managedUserStatus
    post /v1/admin/user/status (ManagedUserStatusRequest) returns (ManagedUserResponse)
    @handler backofficeAudits
    get /v1/admin/audits (BackofficeAuditRequest) returns (BackofficeAuditResponse)
}

// Only preview metadata, never a separate authentication credential.
type (
    IdentityApproval {
        ExpectedRevision int64 `json:"expectedRevision"`
        ExpectedReplacement bool `json:"expectedReplacement"`
    }
    IdentityImpactRequest {
        Identity string `json:"identity,options=email|telegram"`
        Purpose string `json:"purpose,options=bind|replace"`
        Email string `json:"email,optional"`
        InitData string `json:"initData,optional"`
    }
    IdentityImpactData {
        Revision int64 `json:"revision"`
        Replacement bool `json:"replacement"`
        RestrictionSeconds int64 `json:"restrictionSeconds"`
        RestrictedUntil string `json:"restrictedUntil"`
    }
    IdentityImpactResponse {
        Code string `json:"code,options=OK"`
        Message string `json:"message"`
        Data IdentityImpactData `json:"data"`
        TraceId string `json:"traceId"`
    }
    TransferTargetRequest {
        RecipientIdx string `json:"recipientIdx,optional"`
        ReceiveCode string `json:"receiveCode,optional"`
    }
    TransferTargetResponse {
        Code string `json:"code,options=OK"`
        Message string `json:"message"`
        Data CurrentUserData `json:"data"`
        TraceId string `json:"traceId"`
    }
    ReceiveCodeData {
        User CurrentUserData `json:"user"`
        Code string `json:"code"`
        Url string `json:"url"`
        TelegramUrl string `json:"telegramUrl"`
    }
    ReceiveCodeResponse {
        Code string `json:"code,options=OK"`
        Message string `json:"message"`
        Data ReceiveCodeData `json:"data"`
        TraceId string `json:"traceId"`
    }
    TransferLimitPlan {
        Idx string `json:"idx"`
        Name string `json:"name"`
        MinAmount string `json:"minAmount"`
        MaxAmount string `json:"maxAmount"`
        DailyOutgoingLimit string `json:"dailyOutgoingLimit"`
    }
    TransferPolicyData {
        Plan TransferLimitPlan `json:"plan"`
        UsedToday string `json:"usedToday"`
        RemainingToday string `json:"remainingToday"`
        ResetAt string `json:"resetAt"`
        RestrictedUntil string `json:"restrictedUntil"`
    }
    TransferPolicyResponse {
        Code string `json:"code,options=OK"`
        Message string `json:"message"`
        Data TransferPolicyData `json:"data"`
        TraceId string `json:"traceId"`
    }
    SubmitTransferRequest {
        RequestKey string `json:"requestKey"`
        RecipientIdx string `json:"recipientIdx"`
        Amount string `json:"amount"`
    }
    TransferByRequestRequest { RequestKey string `path:"requestKey"` }
    TransferDetailRequest { Idx string `path:"idx"` }
    TransferData {
        Idx string `json:"idx"`
        Direction string `json:"direction,options=in|out"`
        Counterparty CurrentUserData `json:"counterparty"`
        Amount string `json:"amount"`
        Fee string `json:"fee"`
        Unit string `json:"unit,options=USD"`
        Status string `json:"status,options=completed"`
        CreatedAt string `json:"createdAt"`
    }
    TransferResponse {
        Code string `json:"code,options=OK"`
        Message string `json:"message"`
        Data TransferData `json:"data"`
        TraceId string `json:"traceId"`
    }
    LimitPlansRequest { Page int64 `form:"page,default=1,range=[1:1000000]"` }
    LimitPlansData { Plans []TransferLimitPlan `json:"plans"` }
    LimitPlansResponse {
        Code string `json:"code,options=OK"`
        Message string `json:"message"`
        Data LimitPlansData `json:"data"`
        TraceId string `json:"traceId"`
    }
    CreateLimitPlanRequest {
        RequestKey string `json:"requestKey"`
        Name string `json:"name"`
        MinAmount string `json:"minAmount"`
        MaxAmount string `json:"maxAmount"`
        DailyOutgoingLimit string `json:"dailyOutgoingLimit"`
    }
    LimitPlanResponse {
        Code string `json:"code,options=OK"`
        Message string `json:"message"`
        Data TransferLimitPlan `json:"data"`
        TraceId string `json:"traceId"`
    }
    UserLimitPlanRequest { Idx string `path:"idx"` }
    AssignLimitPlanRequest {
        Idx string `path:"idx"`
        PlanIdx string `json:"planIdx"`
        ExpectedPlanIdx string `json:"expectedPlanIdx"`
        Reason string `json:"reason"`
    }
)
@server(group: transfer middleware: AuthTransport,UserAuth)
service platform {
    @handler receiveCode
    get /v1/user/receive-code returns (ReceiveCodeResponse)
    @handler transferTarget
    post /v1/user/transfer-targets/resolve (TransferTargetRequest) returns (TransferTargetResponse)
    @handler transferPolicy
    get /v1/user/transfer-policy returns (TransferPolicyResponse)
    @handler submitTransfer
    post /v1/user/transfers (SubmitTransferRequest) returns (TransferResponse)
    @handler transferByRequest
    get /v1/user/transfers/by-request/:requestKey (TransferByRequestRequest) returns (TransferResponse)
    @handler transferDetail
    get /v1/user/transfers/:idx (TransferDetailRequest) returns (TransferResponse)
}
@server(group: identity middleware: AuthTransport,UserAuth)
service platform {
    @handler identityImpact
    post /v1/user/identities/impact (IdentityImpactRequest) returns (IdentityImpactResponse)
}
@server(group: backoffice middleware: BackofficeTransport,AdminAuth)
service platform {
    @handler limitPlans
    get /v1/admin/transfer-limit-plans (LimitPlansRequest) returns (LimitPlansResponse)
    @handler createLimitPlan
    post /v1/admin/transfer-limit-plans (CreateLimitPlanRequest) returns (LimitPlanResponse)
    @handler userLimitPlan
    get /v1/admin/users/:idx/transfer-limit-plan (UserLimitPlanRequest) returns (TransferPolicyResponse)
    @handler assignLimitPlan
    put /v1/admin/users/:idx/transfer-limit-plan (AssignLimitPlanRequest) returns (TransferPolicyResponse)
}
