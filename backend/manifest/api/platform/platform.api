  Data ManagedDrawVersion `json:"data"`
  TraceId string `json:"traceId"`
 }
 SetDrawControlRequest {
  VersionIdx string `json:"versionIdx,optional"`
  ExpectedRevision int64 `json:"expectedRevision"`
  Reason string `json:"reason"`
 }
)
@server(group: task middleware: AuthTransport,UserAuth)
service platform {
 @handler referralFriends
 get /v1/user/referral-friends (DrawListRequest) returns (ReferralFriendsResponse)
 @handler invitationEarnings
 get /v1/user/invitation-earnings (InvitationEarningsRequest) returns (InvitationEarningsResponse)
}
@server(group: backoffice middleware: BackofficeTransport,AdminAuth)
