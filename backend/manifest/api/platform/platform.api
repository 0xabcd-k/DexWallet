    @handler rewardTransferList
    get /v1/user/reward-transfers (DrawListRequest) returns (RewardTransferListResponse)
}
@server(group: backoffice middleware: BackofficeTransport,AdminAuth)
service platform {
    @handler rewardTransferQueue
    get /v1/admin/reward-transfers (RewardTransferAdminListRequest) returns (RewardTransferListResponse)
    @handler rewardTransferAuditDetail
    get /v1/admin/reward-transfers/:idx (TaskRequest) returns (RewardTransferAdminResponse)
    @handler rewardTransferReview
    post /v1/admin/reward-transfers/:idx/review (RewardTransferReviewRequest) returns (RewardTransferAdminResponse)
}


type (
 ReferralFriendData {
