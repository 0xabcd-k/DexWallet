{
  "name": "@dexwallet/frontend",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": "10.33.4"
  },
  "type": "module",
  "scripts": {
    "dev:user": "pnpm --filter @dexwallet/user dev",
    "dev:user:tg": "pnpm --filter @dexwallet/user dev --mode telegram",
    "dev:merchant": "pnpm --filter @dexwallet/merchant dev",
    "dev:admin": "pnpm --filter @dexwallet/admin dev",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "build": "pnpm -r --if-present build && node scripts/check-build.mjs",
    "test:e2e": "playwright test",
    "test:integration": "node scripts/integration.mjs"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/node": "26.6.5",
    "less": "4.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.8",
    "jsdom": "30.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "@dexwallet/api-client": "workspace:*",
    "@dexwallet/i18n": "workspace:*",
    "react-router": "7.18.4"
  }
}
